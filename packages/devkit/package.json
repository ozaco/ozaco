{
  "name": "@ozaco/devkit",
  "version": "0.2.4",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist",
    "src",
    "ambient.d.ts"
  ],
  "type": "module",
  "types": "./ambient.d.ts",
  "exports": {
    ".": {
      "types": "./ambient.d.ts"
    },
    "./resolve": {
      "import": {
        "types": "./dist/resolve.d.ts",
        "default": "./dist/resolve.js"
      },
      "require": {
        "types": "./dist/resolve.d.cts",
        "default": "./dist/resolve.cjs"
      },
      "source": "./src/resolve.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "rolldown": "1.2.0"
  },
  "devDependencies": {
    "@ozaco/ai": "workspace:*",
    "@ozaco/cli": "workspace:*",
    "@ozaco/client": "workspace:*",
    "@ozaco/db": "workspace:*",
    "@ozaco/server": "workspace:*",
    "@ozaco/std": "workspace:*",
    "tsdown": "catalog:build",
    "unplugin": "3.3.0"
  },
  "peerDependencies": {
    "@ozaco/ai": "*",
    "@ozaco/cli": "*",
    "@ozaco/client": "*",
    "@ozaco/db": "*",
    "@ozaco/server": "*",
    "@ozaco/std": "*",
    "unplugin": "^3.0.0"
  }
}
