{
  "name": "@ozaco/devkit",
  "version": "0.0.1",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist",
    "src",
    "ambient.d.ts"
  ],
  "type": "module",
  "types": "./ambient.d.ts",
  "exports": {
    ".": {
      "types": "./ambient.d.ts"
    },
    "./resolve": "./src/resolve.ts",
    "./client": "./src/client.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./ambient.d.ts"
      },
      "./resolve": {
        "import": {
          "types": "./dist/resolve.d.ts",
          "default": "./dist/resolve.js"
        }
      },
      "./client": {
        "import": {
          "types": "./dist/client.d.ts",
          "default": "./dist/client.js"
        }
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "rolldown": "1.1.0"
  },
  "devDependencies": {
    "@ozaco/db": "workspace:*",
    "@ozaco/server": "workspace:*",
    "@ozaco/std": "workspace:*",
    "tsdown": "catalog:build",
    "unplugin": "3.0.0"
  },
  "peerDependencies": {
    "@ozaco/db": "*",
    "@ozaco/server": "*",
    "@ozaco/std": "*",
    "unplugin": "^3.0.0"
  }
}
