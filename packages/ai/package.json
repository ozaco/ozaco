{
  "name": "@ozaco/ai",
  "version": "0.3.1",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./impl/openai": {
      "import": {
        "types": "./dist/impl/openai.d.ts",
        "default": "./dist/impl/openai.js"
      },
      "require": {
        "types": "./dist/impl/openai.d.cts",
        "default": "./dist/impl/openai.cjs"
      },
      "source": "./src/impl/openai/index.ts"
    },
    "./impl/mock": {
      "import": {
        "types": "./dist/impl/mock.d.ts",
        "default": "./dist/impl/mock.js"
      },
      "require": {
        "types": "./dist/impl/mock.d.cts",
        "default": "./dist/impl/mock.cjs"
      },
      "source": "./src/impl/mock/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ozaco/std": "workspace:*",
    "tsdown": "catalog:build",
    "unrun": "catalog:build"
  },
  "peerDependencies": {
    "@ozaco/std": "*"
  }
}
