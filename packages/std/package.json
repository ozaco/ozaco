      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      },
      "source": "./src/effect/index.ts"
    },
    "./event": {
      "import": {
        "types": "./dist/event.d.ts",
        "default": "./dist/event.js"
      },
      "require": {
        "types": "./dist/event.d.cts",
        "default": "./dist/event.cjs"
      },
      "source": "./src/event/index.ts"
    },
    "./result": {
      "import": {
        "types": "./dist/result.d.ts",
        "default": "./dist/result.js"
      },
      "require": {
        "types": "./dist/result.d.cts",
