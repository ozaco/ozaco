{
  "name": "@ozaco/server",
  "version": "0.0.2",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./service": {
      "import": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "require": {
        "types": "./dist/service.d.cts",
        "default": "./dist/service.cjs"
      },
      "source": "./src/service/index.ts"
    },
    "./bun": {
      "import": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      },
      "require": {
        "types": "./dist/bun.d.cts",
        "default": "./dist/bun.cjs"
      },
      "source": "./src/impl/bun.ts"
    },
    "./docs": {
      "import": {
        "types": "./dist/docs.d.ts",
        "default": "./dist/docs.js"
      },
      "require": {
        "types": "./dist/docs.d.cts",
        "default": "./dist/docs.cjs"
      },
      "source": "./src/plugins/docs/index.ts"
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      },
      "source": "./src/plugins/auth/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ozaco/std": "workspace:*",
    "jose": "6.2.2",
    "rou3": "0.8.1",
    "tsdown": "catalog:build",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@ozaco/std": "*",
    "jose": "^6.0.0",
    "rou3": "*",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
