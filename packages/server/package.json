        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./edge/bun": {
      "import": {
        "types": "./dist/edge/bun.d.ts",
        "default": "./dist/edge/bun.js"
      },
      "require": {
        "types": "./dist/edge/bun.d.cts",
        "default": "./dist/edge/bun.cjs"
      },
      "source": "./src/impl/edge/bun/index.ts"
    },
    "./edge/node": {
      "import": {
        "types": "./dist/edge/node.d.ts",
        "default": "./dist/edge/node.js"
      },
      "require": {
        "types": "./dist/edge/node.d.cts",
        "default": "./dist/edge/node.cjs"
      },
      "source": "./src/impl/edge/node/index.ts"
    },
    "./edge/deno": {
      "import": {
        "types": "./dist/edge/deno.d.ts",
        "default": "./dist/edge/deno.js"
