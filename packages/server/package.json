    "unrun": "catalog:build",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@ozaco/db": "*",
    "@ozaco/std": "*",
    "@ozaco/transport": "*",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
