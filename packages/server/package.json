{
  "name": "@ozaco/server",
  "version": "0.0.9",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./transport/nats": {
      "import": {
        "types": "./dist/transport/nats.d.ts",
        "default": "./dist/transport/nats.js"
      },
      "require": {
        "types": "./dist/transport/nats.d.cts",
        "default": "./dist/transport/nats.cjs"
      },
      "source": "./src/transport/nats/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@streamparser/json": "0.0.22"
  },
  "devDependencies": {
    "@ozaco/std": "workspace:*",
    "nats": "^2.29.3",
    "tsdown": "catalog:build"
  },
  "peerDependencies": {
    "@ozaco/std": "*",
    "nats": "^2.29.3"
  },
  "peerDependenciesMeta": {
    "nats": {
      "optional": true
    }
  }
}
