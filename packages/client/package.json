{
  "name": "@ozaco/client",
  "version": "0.4.5",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen.d.ts",
        "default": "./dist/codegen.js"
      },
      "require": {
        "types": "./dist/codegen.d.cts",
        "default": "./dist/codegen.cjs"
      },
      "source": "./src/codegen/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ozaco/db": "workspace:*",
    "@ozaco/server": "workspace:*",
    "@ozaco/std": "workspace:*",
    "@ozaco/transport": "workspace:*",
    "tsdown": "catalog:build",
    "unrun": "catalog:build",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ozaco/std": "*"
  }
}
