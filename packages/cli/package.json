{
  "name": "@ozaco/cli",
  "version": "0.3.0",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./palette": {
      "import": {
        "types": "./dist/palette.d.ts",
        "default": "./dist/palette.js"
      },
      "require": {
        "types": "./dist/palette.d.cts",
        "default": "./dist/palette.cjs"
      },
      "source": "./src/palette/definition.ts"
    },
    "./spinner": {
      "import": {
        "types": "./dist/spinner.d.ts",
        "default": "./dist/spinner.js"
      },
      "require": {
        "types": "./dist/spinner.d.cts",
        "default": "./dist/spinner.cjs"
      },
      "source": "./src/spinner/definition.ts"
    },
    "./command": {
      "import": {
        "types": "./dist/command.d.ts",
        "default": "./dist/command.js"
      },
      "require": {
        "types": "./dist/command.d.cts",
        "default": "./dist/command.cjs"
      },
      "source": "./src/command/definition.ts"
    },
    "./prompt": {
      "import": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      },
      "require": {
        "types": "./dist/prompt.d.cts",
        "default": "./dist/prompt.cjs"
      },
      "source": "./src/prompt/definition.ts"
    },
    "./table": {
      "import": {
        "types": "./dist/table.d.ts",
        "default": "./dist/table.js"
      },
      "require": {
        "types": "./dist/table.d.cts",
        "default": "./dist/table.cjs"
      },
      "source": "./src/table/definition.ts"
    },
    "./terminal/bun": {
      "import": {
        "types": "./dist/terminal/bun.d.ts",
        "default": "./dist/terminal/bun.js"
      },
      "require": {
        "types": "./dist/terminal/bun.d.cts",
        "default": "./dist/terminal/bun.cjs"
      },
      "source": "./src/terminal/bun.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ozaco/std": "workspace:*",
    "tsdown": "catalog:build",
    "unrun": "catalog:build",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ozaco/std": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
