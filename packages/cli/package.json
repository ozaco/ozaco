{
  "name": "@ozaco/cli",
  "version": "0.4.2",
  "homepage": "https://ozaco.com/",
  "author": "giveerr (https://github.com/giveerr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozaco/ozaco.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "source": "./src/core/index.ts"
    },
    "./palette": {
      "import": {
        "types": "./dist/palette.d.ts",
        "default": "./dist/palette.js"
      },
      "require": {
        "types": "./dist/palette.d.cts",
        "default": "./dist/palette.cjs"
      },
      "source": "./src/palette/index.ts"
    },
    "./prompt": {
      "import": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      },
      "require": {
        "types": "./dist/prompt.d.cts",
        "default": "./dist/prompt.cjs"
      },
      "source": "./src/prompt/index.ts"
    },
    "./spinner": {
      "import": {
        "types": "./dist/spinner.d.ts",
        "default": "./dist/spinner.js"
      },
      "require": {
        "types": "./dist/spinner.d.cts",
        "default": "./dist/spinner.cjs"
      },
      "source": "./src/spinner/index.ts"
    },
    "./table": {
      "import": {
        "types": "./dist/table.d.ts",
        "default": "./dist/table.js"
      },
      "require": {
        "types": "./dist/table.d.cts",
        "default": "./dist/table.cjs"
      },
      "source": "./src/table/index.ts"
    },
    "./command": {
      "import": {
        "types": "./dist/command.d.ts",
        "default": "./dist/command.js"
      },
      "require": {
        "types": "./dist/command.d.cts",
        "default": "./dist/command.cjs"
      },
      "source": "./src/command/index.ts"
    },
    "./impl/memory": {
      "import": {
        "types": "./dist/impl/memory.d.ts",
        "default": "./dist/impl/memory.js"
      },
      "require": {
        "types": "./dist/impl/memory.d.cts",
        "default": "./dist/impl/memory.cjs"
      },
      "source": "./src/impl/memory/index.ts"
    },
    "./impl/node": {
      "import": {
        "types": "./dist/impl/node.d.ts",
        "default": "./dist/impl/node.js"
      },
      "require": {
        "types": "./dist/impl/node.d.cts",
        "default": "./dist/impl/node.cjs"
      },
      "source": "./src/impl/node/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@ozaco/std": "workspace:*",
    "tsdown": "catalog:build",
    "unrun": "catalog:build",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ozaco/std": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
