{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/dist/**"],
  "sortTailwindcss": {},
  "semi": false,
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "jsxSingleQuote": true,
  "printWidth": 100,
  "useTabs": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "quoteProps": "as-needed",
  "singleQuote": true,
  "bracketSpacing": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "ozaco",
        "elementNamePattern": ["std:*", "cli:*", "server:*", "db:*", "ai:*"]
      }
    ],
    "groups": ["ozaco", "builtin", "external", "internal", "parent", ["sibling", "index"]],
    "internalPattern": ["@/", "~/"],
    "newlinesBetween": true,
    "partitionByComment": true,
    "sortSideEffects": false
  }
}
