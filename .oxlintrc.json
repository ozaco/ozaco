{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "restriction": "error",
    "suspicious": "error",
    "pedantic": "error",
    "style": "error"
  },
  "plugins": ["unicorn", "typescript", "oxc", "import", "jsx-a11y", "react-perf", "promise"],
  "rules": {
    "no-unused-vars": "error",
    "no-empty-object-type": "error",
    "max-lines-per-function": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-barrel-file": "off",
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",

    "unicorn/no-array-for-each": "warn",
    "unicorn/no-this-assignment": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-at": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-null": "off",
    "unicorn/new-for-builtins": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-array-method-this-argument": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/number-literal-case": "off",
    "unicorn/prefer-math-trunc": "off",
    "unicorn/import-style": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/max-nested-calls": "off",

    "eslint/max-lines": "off",
    "eslint/no-bitwise": "off",
    "eslint/id-length": "off",
    "eslint/sort-keys": "off",
    "eslint/no-undefined": "off",
    "eslint/no-ternary": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/max-statements": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/max-depth": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-warning-comments": "off",
    "eslint/func-names": "off",
    "eslint/no-empty-function": "off",
    "eslint/func-style": "off",
    "eslint/no-console": "off",
    "eslint/no-plusplus": "off",
    // "eslint/func-style": ["error", "expression"],
    "eslint/capitalized-comments": "off",
    "eslint/no-continue": "off",
    "eslint/no-implicit-coercion": "off",
    "eslint/sort-imports": "off",
    "eslint/no-void": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "eslint/new-cap": "off",
    "eslint/no-use-before-define": "off",
    "eslint/no-inline-comments": "off",
    "eslint/init-declarations": "off",
    "eslint/no-nested-ternary": "off",
    "eslint/complexity": "off",
    "eslint/require-yield": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-useless-return": "off",
    "prefer-named-capture-group": "off",
    "eslint/one-var": "off",
    "eslint/no-redeclare": "off",

    "typescript/ban-types": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/no-namespace": "off",
    "typescript/no-empty-interface": "off",
    "typescript/array-type": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-invalid-void-type": "off",
    "typescript/parameter-properties": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/unified-signatures": "off",
    "typescript/no-explicit-any": "error",
    "typescript/explicit-member-accessibility": "off",
    "typescript/method-signature-style": "off",

    "promise/spec-only": "off",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-then": "off",
    "promise/prefer-await-to-callbacks": "off",
    "promise/catch-or-return": "off",
    "promise/prefer-catch": "off",

    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/named": "error",
    "import/namespace": "error",
    "import/default": "error",
    "import/export": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-cycle": "off",
    "import/no-nodejs-modules": "off",
    "import/no-anonymous-default-export": "off",
    "import/max-dependencies": "off",

    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/*.d.ts", "**/*.gen.ts", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["apps/panel/src/**/*.tsx", "apps/observe/src/**/*.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/interactive-supports-focus": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "react-perf/jsx-no-jsx-as-prop": "off"
      }
    },
    {
      "files": ["packages/server/src/core/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "server:impl/*",
                  "server:plugins",
                  "server:plugins/*",
                  "server:app",
                  "../impl/*",
                  "../../impl/*",
                  "../plugins/*",
                  "../../plugins/*",
                  "../app/*",
                  "../../app/*"
                ],
                "message": "server core must not import impl, plugins or app (layers: core ← impl ← plugins ← app)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/src/impl/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "server:plugins",
                  "server:plugins/*",
                  "server:app",
                  "../../plugins/*",
                  "../../../plugins/*",
                  "../../app/*",
                  "../../../app/*"
                ],
                "message": "server impl may import only core"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/src/plugins/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "server:plugins",
                  "server:plugins/*",
                  "server:app",
                  "../*/",
                  "../*/definition",
                  "../*/types",
                  "../*/internal",
                  "../*/internal/*",
                  "../../app/*"
                ],
                "message": "a server plugin may import only core/impl — never another plugin or the app"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/db/src/core/**/*.ts", "packages/transport/src/core/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["db:impl/*", "transport:impl/*", "../impl/*", "../../impl/*"],
                "message": "core must not import impl"
              }
            ]
          }
        ]
      }
    }
  ]
}
